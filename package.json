{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dev-rover",
  "title": "DevRover",
  "description": "Rover through Your Development Journey",
  "icon": "icon.svg",
  "author": "gaarahan",
  "license": "MIT",
  "commands": [
    {
      "name": "dev_rover",
      "title": "DevRover",
      "description": "Rover through Your Development Journey",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.6"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
